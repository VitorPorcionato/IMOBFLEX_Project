DATABASE_URL=jdbc:mysql://localhost:3306/imobflex?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DATABASE_USER=imobflex
DATABASE_PASSWORD=replace-with-a-long-random-password
MAIL_HOST=localhost
MAIL_PORT=1025
PUBLIC_URL=http://localhost:3000
BOOTSTRAP_EMAIL=admin@example.test
BOOTSTRAP_PASSWORD=ReplaceWithAStrongPassword25
COOKIE_SECURE=false

# Base64 de 32 bytes aleatórios; obrigatório para imóveis que exigem CPF.
PRIVACY_ENCRYPTION_KEY=
# Ativar após revisar relatório e testar limpeza em cópia isolada.
PRIVACY_RETENTION_ENABLED=false

# Opcional: nunca usar NEXT_PUBLIC_ para a chave
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
